# 研究辅助镜像：预装 bubblewrap + gcc，编译好的 landlock-run 二进制
# 用于 Docker seccomp 对照测试（默认 / seccomp=unconfined / --cap-add SYS_ADMIN / --privileged）
FROM node:22-bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq bubblewrap gcc && rm -rf /var/lib/apt/lists/*
COPY landlock-run-main.c /opt/landlock-run-main.c
RUN gcc -O2 -o /opt/landlock-run /opt/landlock-run-main.c
# 把 DSH 的探测/轮廓脚本也放进来
ENV PATH="/opt:$PATH"
WORKDIR /work
CMD ["bash"]