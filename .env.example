# dshc environment overrides - copy to .env and edit (.env is gitignored).
# Every entry is optional; commented values are the built-in defaults.

# LLM credential (required to boot). DSH forbids DEEPSEEK_* in container-side
# files; inject through this host-side environment instead.
# DEEPSEEK_API_KEY=sk-...

# --- Build-time knobs (only useful on slow/throttled networks) ---
APT_MIRROR=mirrors.aliyun.com                  # default: deb.debian.org
NPM_REGISTRY=https://registry.npmmirror.com    # default: https://registry.npmjs.org

# --- Runtime knobs ---
DSH_PERMISSION_MODE=workspace-write            # or danger-full-access
DSHC_PORT=3080                                 # host-side GUI port (always loopback-bound)
DEEPSEEK_BASE_URL=                             # custom LLM endpoint; blank = https://api.deepseek.com

# --- Workspace ---
# compose.yml mounts ./workspace at the container's /workspace. This crosses
# the container boundary: the agent reads/writes that host folder within its
# permission mode. Delete the mount line in compose.yml to keep the workspace
# isolated inside the container instead.
