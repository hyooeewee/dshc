# dshc environment overrides - copy to .env and edit (.env is gitignored).
# Every entry is optional; commented values are the built-in defaults.

# Optional
# DEEPSEEK_API_KEY=sk-...

# --- Build-time knobs ---
# Optional(default: deb.debian.org)
APT_MIRROR=mirrors.aliyun.com

# Optional(default: https://registry.npmjs.org)
NPM_REGISTRY=https://registry.npmmirror.com

# --- Runtime knobs ---
# Optional(default: read-only): read-only | workspace-write | danger-full-access
DSH_PERMISSION_MODE=workspace-write

# Optional(default: 3080)
DSHC_PORT=3080

# Optional(default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=

# --- First-boot preference seeds ---
# Optional(default: en): zh | en
DSHC_LOCALE=zh

# Optional(default: system): light | dark | system
DSHC_THEME=dark
