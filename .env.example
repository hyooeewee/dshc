# ==========================================================
# dshc environment overrides
# Copy to `.env` and edit. `.env` is gitignored and never
# committed. Every entry starts commented out and takes its
# built-in default; uncomment an entry only to override it.
#
# Entry shape, three lines:
#   # <access>(default: <value>): <v1> | <v2> | <v3>
#   # <description, optional, may span multiple lines>
#   # VAR=value            (uncomment to set)
#
# access   Required               no usable default; service needs it
#          Optional(default: x)   omit the entry to use x
#          Optional               omit the entry to leave it unset
# enum     listed only when the allowed values are a finite set
# bounds   for open values (ports, ids) put the limit in the
#          description line instead
# ==========================================================

# ==================== Build-time knobs ====================

# Optional(default: deb.debian.org)
# Debian mirror used by APT during the image build; set it when
# the default is slow or unreachable on your network.
# APT_MIRROR=mirrors.aliyun.com

# Optional(default: https://registry.npmjs.org)
# npm registry used to resolve dependencies during the image build.
# NPM_REGISTRY=https://registry.npmmirror.com

# ===================== Runtime knobs ======================

# Required
# DeepSeek API key. Without it the container still boots but
# has no model access. Uncomment and set your own key.
# DEEPSEEK_API_KEY=sk-...

# Optional(default: workspace-write): read-only | workspace-write | danger-full-access
# Permission mode for the agent inside the container.
# DSH_PERMISSION_MODE=workspace-write

# Optional(default: 3080)
# Host port the GUI is published on.
# DSHC_PORT=3080

# Optional(default: https://api.deepseek.com)
# Alternative model API base URL, e.g. a compatible proxy.
# DEEPSEEK_BASE_URL=

# Optional(default: 1000)
# Host UID that owns files written into ./workspace. Set it to
# `id -u` so the host user owns the container's output.
# PUID=1000

# Optional(default: 1000)
# Host GID that owns files written into ./workspace. Set it to
# `id -g` so the host group owns the container's output.
# PGID=1000

# ============== First-boot preference seeds ===============

# Optional(default: en): zh | en
# UI language seeded into settings.yaml on first boot only;
# later GUI edits always win.
# DSHC_LOCALE=zh

# Optional(default: system): light | dark | system
# UI theme seeded into settings.yaml on first boot only;
# later GUI edits always win.
# DSHC_THEME=dark